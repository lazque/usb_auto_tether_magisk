#!/sbin/sh
###############################################################
# 通用模块安装脚本（META-INF/com/google/android/update-binary）
#  Magisk / KernelSU / APatch 的 App 安装走各自的原生流程，
#  本脚本用于 Recovery 或第三方方式刷入时的兼容。
###############################################################

umask 022

OUTFD=$2
ZIPFILE=$3

ui_print() {
  if [ -n "$OUTFD" ] && [ -e "/proc/self/fd/$OUTFD" ] && [ "$OUTFD" != "1" ]; then
    echo "ui_print $1" >> "/proc/self/fd/$OUTFD"
    echo "ui_print" >> "/proc/self/fd/$OUTFD"
  else
    echo "$1"
  fi
}

abort() {
  ui_print "安装失败：$1"
  exit 1
}

[ -f "$ZIPFILE" ] || abort "找不到刷机包：$ZIPFILE"
command -v unzip >/dev/null 2>&1 || abort "缺少 unzip，请改用 Magisk / KernelSU App 安装"

TMPD=/dev/tmp/usbtether.$$
rm -rf "$TMPD"
mkdir -p "$TMPD" || abort "无法创建临时目录"

unzip -o "$ZIPFILE" "module.prop" -d "$TMPD" >/dev/null 2>&1 || abort "无法解压 module.prop"
ID=$(grep '^id=' "$TMPD/module.prop" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '\r\n ')
[ -n "$ID" ] || abort "module.prop 缺少 id 字段"

mkdir -p /data/adb/modules
MODPATH=/data/adb/modules/$ID
rm -rf "$MODPATH"
mkdir -p "$MODPATH" || abort "无法创建 $MODPATH"

unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >/dev/null 2>&1 || abort "解压模块文件失败"

chmod 0755 "$MODPATH"
for f in "$MODPATH"/*.sh "$MODPATH"/common/*.sh; do
  [ -f "$f" ] && chmod 0755 "$f"
done
chmod 0644 "$MODPATH/module.prop" "$MODPATH/config.sh" "$MODPATH/README.md" 2>/dev/null

if [ -f "$MODPATH/customize.sh" ]; then
  sh "$MODPATH/customize.sh" "$MODPATH"
fi

rm -rf "$TMPD"
ui_print "安装完成：$MODPATH"
exit 0
